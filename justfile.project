# Seeded by vigOS devkit — yours to edit; upgrades never overwrite this file.
# Bugs / missing tools: https://github.com/vig-os/devkit/issues

# ===============================================================================
# PROJECT RECIPES - Team-shared customizations
# This file is git-tracked and preserved during devcontainer upgrades.
# Add team-shared recipes here that everyone on the project should use.
# ===============================================================================
# ===============================================================================
# PROJECT VARIABLES
# ===============================================================================

project := "revkit"
# ===============================================================================
# INFO
# ===============================================================================

# Show project information
[group('info')]
info:
    @echo "Project: {{ project }}"

# -------------------------------------------------------------------------------
# CODE QUALITY
# -------------------------------------------------------------------------------

# revkit is a Bun workspace (ADR-0001); the recipes below wrap `bun` / `astro`
# / `playwright` from the flake dev shell. They are guarded on package.json so
# they REPORT the skip instead of no-oping in silence — matching devkit's own
# language-neutral guard style — but do not assume Python tooling is present.

# Run TypeScript / Astro type checks across the workspace: `astro check` in
# site, then the `typecheck` script of every packages/* member that defines
# one, so a new package joins without a recipe edit.
[group('quality')]
lint:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -f package.json ]; then echo "just lint: no package.json — skipping"; exit 0; fi
    (cd site && bun run check)
    for manifest in packages/*/package.json; do
      if jq -e '.scripts.typecheck' "$manifest" >/dev/null; then
        (cd "$(dirname "$manifest")" && bun run typecheck)
      fi
    done

# Format source (Biome is not wired in M1 — the guardrails hooks enforce the
# rules that matter here; add Biome in the next PR if a veto reviewer wants
# it, so this scaffold PR stays lean). Kept as a no-op with a clear message.
[group('quality')]
format:
    @echo "just format: no formatter wired yet (see PR #6 body for the choice-for-veto)"

# Run pre-commit hooks on all files
[group('quality')]
precommit:
    prek run --all-files

# -------------------------------------------------------------------------------
# TESTING
# -------------------------------------------------------------------------------

# Run unit tests (bun test) in each package that has them, then `revkit
# check` over the whole repo (ADR-0005 M1 item 4), then the site's
# Playwright smoke. Bun test runs per-package rather than at the workspace
# root because it would otherwise walk `site/tests/*.spec.ts` — which are
# Playwright specs and refuse to load in bun test. The site's own bun tests
# live under `src/content/schemas/` (outside the Playwright testDir) so both
# runners coexist without a collision. Playwright's own suite builds the
# site once and runs Chromium; WebKit is opt-in via REVKIT_ENABLE_WEBKIT=1
# (see site/playwright.config.ts) pending #19. `revkit check` runs
# `--online` when GITHUB_TOKEN is exported (CI test lane does not export
# it today; the offline pass still validates every allow annotation's
# shape).
#
# Every leg below is instrumented because of issue #74, which saw the CI
# Tests job hang ~18 min in `test/serve/asks-http.test.ts` and die at the
# 20-minute ceiling with nothing but a group header in the log — the single
# most expensive possible failure mode, since it burns 20 minutes of a
# runner to learn nothing. `.github/workflows/ci.yml` is devkit-managed and
# calls `just test` (ci.yml:282), so every guard lives HERE, in a
# consumer-owned file.
#
# Four instruments, each covering a gap the others cannot:
#
#   1. WHICH RUNTIME. Prints `bun --version` and its resolved path first.
#      CI's toolchain jobs run inside the vig-os devcontainer image, so the
#      suite is tested against THAT image's bun, not the flake's pinned
#      1.3.13 that local development uses — two different runtimes under
#      one recipe name. This repo already carries one behaviour that is
#      specific to bun 1.3.13 (the #49 watcher re-arm bug), so "which bun
#      ran this" is a question with a real answer, not a formality. One
#      line of output makes it answerable from the log after the fact.
#
#   2. FD BUDGET. Every `startDaemon` leaks 2 descriptors on bun 1.3.13
#      (Bun's `fs.watch(...).close()` does not free the fd; cross-checked
#      against node v24.21.0, which does not leak). Measured `packages/cli`
#      peak: 4449. GitHub-hosted runners cap the soft `nofile` limit at
#      1024, so `EMFILE` is a matter of time. `ulimit -n` is set to give the
#      run headroom so it COMPLETES, and the peak is then checked against
#      `test_fd_budget` so the next leak is a NAMED failure instead of a
#      crash. This is headroom plus a tripwire, NOT a fix — the fds are
#      Bun's to leak and revkit's teardown is already correct.
#
#   3. WALL-CLOCK BOUNDS. `timeout --signal=ABRT` per leg, so a stall is
#      a red leg that names itself instead of a cancelled job. Be precise
#      about what that buys: bun emits NO JS stack for a blocked event loop
#      (verified on 1.3.13 — ABRT just dumps core), so the bound does not
#      produce a trace. What it does produce is the leg label, the budget
#      it blew, and — on a runtime that emits them — the test file bun had
#      reached. That is the difference between 20 wasted minutes and one
#      red line.
#      Budgets come from measurement (see the per-leg comment) with enough
#      headroom for a healthy CI run (measured: 7m33s for the whole job)
#      that the bound ALWAYS fires before the workflow's own 20-minute
#      `timeout-minutes` — a bound that could lose the race to GitHub's
#      cancellation would be worthless.
#
#   4. `bun --timeout`. The default is 5000ms per test, which is below
#      what a legitimately slow daemon or E2E-build test needs on a 2-core
#      CI container. Raised to 30s. NOTE this is NECESSARY BUT NOT
#      SUFFICIENT, and both halves were verified on bun 1.3.13:
#        - a hung `await` in `beforeEach` DOES trip it ("a
#          beforeEach/afterEach hook timed out for this test");
#        - an unbounded SYNC block does NOT. `--timeout` is detected only
#          after the block returns, and a block that never returns blocks
#          the event loop, so the timeout can never fire — the run prints
#          its header and then nothing, which is exactly the #74 symptom.
#      That second case is why instrument 3 is here and not optional.
[group('test')]
test *args:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -f package.json ]; then echo "just test: no package.json — skipping"; exit 0; fi
    REVKIT_FD_ULIMIT_BEFORE="$(ulimit -n)"

    # --- 1. record which runtime is under test (see note 1 above) ---
    printf 'just test: bun %s at %s\n' "$(bun --version)" "$(command -v bun)"

    # --- 2. fd headroom (see note 2 above) ---
    # `ulimit -n` is a soft limit. Set it unconditionally so the suite
    # gets the SAME ceiling everywhere — an unbounded soft limit on a
    # dev box masks the very exhaustion CI would hit. Raising it is the
    # point; lowering a host that is already generous is harmless
    # because the budget sits ~15x above the measured peak. A failure is
    # NOT fatal (the hard limit may be lower), but the resulting value
    # is printed either way so the log records what the run actually got.
    ulimit_in="{{test_fd_limit}}"
    if ! ulimit -n "$ulimit_in" 2>/dev/null; then
      printf 'just test: WARNING could not set ulimit -n to %s (hard limit %s); continuing\n' \
        "$ulimit_in" "$(ulimit -Hn)"
    fi
    printf 'just test: ulimit -n is now %s (host default was %s)\n' "$(ulimit -n)" "$REVKIT_FD_ULIMIT_BEFORE"

    .claude/skills/revkit_run/test-lib.sh

    # run_leg <label> <budget-seconds> <command...>
    # Wraps one leg in BOTH the wall-clock bound and the fd peak check, so
    # no leg can be added later that silently lacks them.
    #
    # On a stall, the leg's captured output is grepped for the test file bun
    # was working on, when the runtime is one that says. Best-effort by
    # design: bun 1.3.13 buffers its per-file headers when stdout is not a
    # TTY, so on THAT runtime the stalling file is genuinely absent from the
    # log and the message says so and hands over a bisect command instead. A
    # CI runtime that does emit headers gets the file named for free — the
    # reason the runtime line is printed first is precisely that these two
    # runtimes differ.
    run_leg() {
      local label="$1" budget="$2"; shift 2
      local log; log="$(mktemp)"
      printf '\njust test: === %s (budget %ss) ===\n' "$label" "$budget"
      set +e
      timeout --signal=ABRT --kill-after=30s "${budget}s" \
        ./scripts/fd-budget.sh --budget "{{test_fd_budget}}" -- "$@" 2>&1 | tee "$log"
      local status="${PIPESTATUS[0]}"
      set -e
      if [ "$status" -eq 124 ] || [ "$status" -eq 137 ]; then
        {
          printf '\njust test: STALL — leg %s exceeded its %ss wall-clock budget and was killed.\n' "$label" "$budget"
          local last
          last="$(grep -oE '[A-Za-z0-9_./-]+\.(test|spec)\.[cm]?[jt]sx?:' "$log" | tail -1 || true)"
          if [ -n "$last" ]; then
            printf 'just test: last test file named in the output was %s.\n' "$last"
          else
            printf 'just test: bun named no test file, so the hang cannot be pinned to one from the log.\n'
            printf 'just test: bun %s buffers its per-file headers when stdout is not a TTY, so the file\n' "$(bun --version)"
            printf 'just test: that stalled is invisible here. Re-run the leg with a path filter to bisect:\n'
            printf 'just test:   just test test/serve/<file>.test.ts\n'
          fi
          printf 'just test: a leg that overruns this long is a STALL, not a slow test. bun --timeout\n'
          printf 'just test: cannot catch a blocked event loop (verified on bun 1.3.13), which is why this\n'
          printf 'just test: outer bound exists.\n'
        } >&2
      fi
      rm -f "$log"
      return "$status"
    }

    # Budgets, from measured healthy local times on an 88-core host
    # (packages/cli 104s / review-core 2s / site schemas 1s / check 3s /
    # build 8s / Playwright 228s) and the one known good CI run (7m33s
    # for the whole job, so ~1.3x local). Each leg gets >=3x its measured
    # time, and any single stalled leg still trips its bound before the
    # workflow's 20-minute ceiling: worst case is a stalled Playwright leg
    # at 241s of healthy work + 720s = 16 min, a stalled cli leg at
    # 540s + 241s = 13 min.
    run_leg packages/cli "{{test_leg_timeout_cli}}" env REVKIT_E2E_BUILD=1 bash -c "cd packages/cli && bun test --timeout {{bun_test_timeout_ms}} {{ args }}"
    run_leg packages/review-core "{{test_leg_timeout_review_core}}" bash -c "cd packages/review-core && bun test --timeout {{bun_test_timeout_ms}} {{ args }}"
    run_leg site/schemas "{{test_leg_timeout_schemas}}" bash -c "cd site && bun test --timeout {{bun_test_timeout_ms}} src/content/schemas/ {{ args }}"
    just check
    run_leg site/playwright "{{test_leg_timeout_e2e}}" just e2e

# Wall-clock budget per leg, in seconds. See note 3 on `test` above for
# the measurements these come from.
test_leg_timeout_cli := "540"
test_leg_timeout_review_core := "180"
test_leg_timeout_schemas := "180"
test_leg_timeout_e2e := "720"

# Per-test bun timeout. The 5s default is too tight for a slow daemon or
# E2E-build test on a 2-core CI container; 30s still turns a hung `await`
# into a named failure in seconds. See note 4 on `test` above for why this
# cannot be the only stall guard.
bun_test_timeout_ms := "30000"

# Soft descriptor limit for the suite. GitHub-hosted runners sit at 1024,
# which the measured suite peak (~4.4k) blows through. 65536 is ~15x that
# peak and inside every host's hard limit.
test_fd_limit := "65536"

# Descriptor ceiling for one leg, checked by scripts/fd-budget.sh.
#
# Measured on `bun 1.3.13` (peak = the whole process TREE, so the
# Playwright workers and their daemons are included):
#
#   packages/cli        4449   worker-count independent — bun test is a
#                              single process; the stable number, and the
#                              one the budget is sized from
#   site/playwright      499   at CI settings (`workers: 1`)
#                      4683   on an 88-core host, i.e. ~44 Playwright
#                              workers — scales with worker count
#   packages/review-core   98
#   site/schemas          139
#
# 8192 clears the worst leg observed in either configuration (4683) by
# ~1.75x while staying far below a runaway, so the guard fails on a leak
# that got an order of magnitude worse rather than on ordinary drift.
# It is deliberately NOT tightened to the 4449 figure: a dev box with
# many cores legitimately runs more Playwright workers, and a budget that
# red-lined on a big workstation would train everyone to ignore it.
test_fd_budget := "8192"

# Regenerate the pipeline-digest fixture that
# `packages/cli/test/build/own-build-unchanged.test.ts` compares
# against (issue #57). Run this after a LEGITIMATE change to the
# rendering pipeline — a new rehype plugin, a Starlight upgrade, a
# tweak to `astro.config.mjs`. The recipe sets
# `REVKIT_UPDATE_OWN_DIGEST=1` so the test WRITES the digest
# instead of asserting. Commit the resulting
# `packages/cli/test/build/fixtures/pipeline-digest.json`.
[group('quality')]
update-own-digest:
    REVKIT_UPDATE_OWN_DIGEST=1 REVKIT_E2E_BUILD=1 bash -c 'cd packages/cli && bun test test/build/own-build-unchanged.test.ts'

# Run the revkit authoring guards over the workspace (ADR-0005). Offline
# by default; passes `--online` when GITHUB_TOKEN is available so `revkit
# escalate` annotations get verified against GitHub in CI when the
# workflow forwards the token. A pre-commit hook (see flake.nix's `hooks`
# block) invokes the same command on any content-shaped stage change.
[group('quality')]
check *args:
    @if [ -n "${GITHUB_TOKEN:-}" ]; then \
      bun packages/cli/bin/revkit.js check --online {{ args }}; \
    else \
      bun packages/cli/bin/revkit.js check {{ args }}; \
    fi

# Run bun unit tests with coverage. Reports to the terminal by default;
# `just test-cov --coverage-reporter=lcov` writes an lcov file. Walks every
# package that grows unit tests over time (packages/cli, site's schema
# tests today) so new ones join without a recipe edit.
[group('test')]
test-cov *args:
    @if [ ! -f package.json ]; then \
      echo "just test-cov: no package.json — skipping"; \
    else \
      cd packages/cli && bun test --coverage {{ args }} && cd ../.. && \
      cd packages/review-core && bun test --coverage {{ args }} && cd ../.. && \
      cd site && bun test --coverage src/content/schemas/ {{ args }}; \
    fi

# Run the Playwright browser suite by itself (skips the bun unit tests).
# ALWAYS builds first: axe over stale HTML and visual baselines against
# stale HTML both silently pass a regression that landed after the last
# build (PR #31 review, the low-contrast paragraph reproducer). One
# build per run — `just test` calls this recipe, so the outer `just
# build` step used to double up and has been removed there.
[group('test')]
e2e *args:
    @if [ ! -f site/package.json ]; then \
      echo "just e2e: no site/package.json — skipping"; \
    else \
      just build && \
      cd site && bun run test:e2e -- {{ args }}; \
    fi

# Regenerate the visual-regression baselines committed under
# `site/tests/visual.spec.ts-snapshots/`. Intentional-only: run this
# when a PR means to change what the site looks like, review the
# resulting image diff in code review, and commit the updated files.
# Extra args pass through to Playwright (e.g.
# `just e2e-update visual.spec.ts -g phone` narrows the update).
# Also builds first — same reason as `just e2e`, otherwise a stale
# `dist/` would snapshot the previous build.
[group('test')]
e2e-update *args:
    @if [ ! -f site/package.json ]; then \
      echo "just e2e-update: no site/package.json — skipping"; \
    else \
      just build && \
      cd site && bun run test:e2e -- --update-snapshots=all {{ args }}; \
    fi

# -------------------------------------------------------------------------------
# DEPENDENCIES
# -------------------------------------------------------------------------------

# Sync workspace dependencies. `--frozen-lockfile` matches CI: if bun.lock
# would change, this fails loudly so a missing pin is caught locally.
[group('deps')]
sync *args="--frozen-lockfile":
    @if [ -f package.json ]; then \
      bun install {{ args }}; \
    else \
      echo "just sync: no package.json — skipping"; \
    fi

# Manual dependency bump. Renovate owns routine bumps (ADR-0001): it opens
# PRs that update the exact pins in package.json + bun.lock, so this recipe
# is an escape hatch, not the normal path. Prints the reminder and runs
# `bun update --latest` — with exact pins, plain `bun update` is a no-op.
[group('deps')]
update *args="--latest":
    @echo "Note: Renovate owns routine dependency bumps (ADR-0001); use this only for a manual escape."
    bun update {{ args }}
    @just sync --no-frozen-lockfile

# -------------------------------------------------------------------------------
# BUILD / DEV
# -------------------------------------------------------------------------------

# Astro dev server for the review site (hot-reload). See ADR-0001.
[group('build')]
dev *args:
    cd site && bun run dev -- {{ args }}

# Build the review site to static output (site/dist), then run the
# output-gate sanitiser (`revkit check-dist`) over the built HTML —
# ADR-0012 defence in depth. Source guards can miss a parser
# differential (bypass classes surfaced in PR #23 round-2 review);
# check-dist parses every built page with a real DOM parser (linkedom)
# and refuses `on*` attrs, `javascript:`/`data:`/`vbscript:` URLs,
# `<iframe>`/`<object>`/`<base>`/`<meta refresh>`, external stylesheets,
# and any inline `<script>` whose SHA-256 is not in
# `packages/cli/src/dist-check-allowlist.json`.
[group('build')]
build:
    cd site && bun run build
    bun packages/cli/bin/revkit.js check-dist site/dist

# Clean workspace build artefacts (Astro output, Playwright reports, TS
# incremental info). Leaves node_modules/ and bun.lock alone.
[group('build')]
clean-artifacts:
    rm -rf site/dist site/.astro site/test-results site/playwright-report site/blob-report
    find . -name '*.tsbuildinfo' -type f -delete 2>/dev/null || true

# ===============================================================================
# PROJECT-SPECIFIC RECIPES
# ===============================================================================

# -------------------------------------------------------------------------------
# AGENT
# -------------------------------------------------------------------------------

# Install the vig-os devkit Claude Code plugin, pinned to this repo's
# DEVKIT_VERSION by default. Local scope (.claude/settings.local.json,
# gitignored) because devkit regenerates .claude/settings.json on upgrade, so a
# project-scope entry would be silently dropped (vig-os/devkit#1765). Re-run
# after a devkit upgrade to move the marketplace to the new tag. `ref` overrides
# the pin (e.g. `just claude-plugin dev` for the unreleased plugin); the plugin
# first ships in the release after 1.17.0.
[group('agent')]
claude-plugin ref="":
    #!/usr/bin/env bash
    set -euo pipefail
    ref="{{ ref }}"
    if [[ -z "$ref" ]]; then
      ref=$(sed -n 's/^DEVKIT_VERSION=//p' .vig-os)
      [[ "$ref" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "DEVKIT_VERSION '$ref' is not X.Y.Z" >&2; exit 1; }
    fi
    [[ "$ref" =~ ^[A-Za-z0-9._/-]+$ ]] || { echo "ref '$ref' has unexpected characters" >&2; exit 1; }
    if ! gh api "repos/vig-os/devkit/contents/.claude-plugin/marketplace.json?ref=${ref}" --silent 2>/dev/null; then
      echo "vig-os/devkit@${ref} ships no Claude Code plugin (.claude-plugin/marketplace.json)." >&2
      echo "Use a later release, or preview the unreleased plugin: just claude-plugin dev" >&2
      exit 1
    fi
    claude plugin marketplace remove vigos-devkit --scope local >/dev/null 2>&1 || true
    claude plugin marketplace add "vig-os/devkit@${ref}" --sparse .claude-plugin plugins --scope local
    claude plugin install devkit@vigos-devkit --scope local
    echo "devkit plugin @${ref} installed (local scope): /devkit:status, /devkit:upgrade, ..."

# End-to-end dogfood of the M2 agent channel loop (ADR-0007, issue #7). Builds
# the site, starts an ISOLATED `revkit serve` in a temp state dir, spawns a
# disposable LOCKED-DOWN test Claude session (no built-in tools, only
# `mcp__revkit__{threads,reply,resolve}`) in a flock pane, then drives a
# comment through the rail UI with Playwright and waits for the test agent to
# reply with `ack <nonce>` and resolve. The lockdown is proven pre-launch
# against the real claude process (/proc/<pid>/cmdline + /proc/<pid>/environ
# vs a true allowlist), not by any model behaviour. Requires a
# logged-in Claude (`claude auth`), a running flock server (`flk`), and the
# nix dev shell. Not part of `just test` or CI. Writes a redacted transcript
# to `.revkit/dogfood/last.log`, unlinks the daemon.log (unredacted — holds
# the launch code) at teardown by default; set
# `REVKIT_DOGFOOD_KEEP_DAEMON_LOG=1` to keep a redacted copy. On success
# writes a screenshot to
# `.revkit/dogfood/reply-visible.png`. Cleanup runs on any exit path and
# ends with a self-check for leaked panes or subprocesses (exit 3 on leak).
# See `.claude/skills/revkit_dogfood/SKILL.md` for the full runbook and the
# failure playbook.
[group('agent')]
dogfood *args:
    bun packages/cli/src/dogfood/main.ts {{ args }}

# -------------------------------------------------------------------------------
# CLOUDFLARE
# -------------------------------------------------------------------------------

# Run wrangler with the local Cloudflare credentials (ADR-0014). The token is
# loaded from ~/.config/revkit/cf.env (mode 600) for this one call only and is
# never exported into the dev shell. Example: `just cf whoami`.
[group('cloudflare')]
cf *args:
    #!/usr/bin/env bash
    set -euo pipefail
    env_file="${REVKIT_CF_ENV:-$HOME/.config/revkit/cf.env}"
    [[ -f "$env_file" ]] || { echo "missing $env_file (see CLAUDE.md, Secrets)" >&2; exit 1; }
    [[ "$(stat -c %a "$env_file" 2>/dev/null || stat -f %Lp "$env_file")" == "600" ]] || { echo "$env_file must be mode 600" >&2; exit 1; }
    set -a; . "$env_file"; set +a
    WRANGLER_SEND_METRICS=false exec wrangler {{ args }}
